# 既存PowerShellスクリプトと同じ版別カウンターをMac/Linux/Webでも使用する
if(NOT Distribution MATCHES "^(Mac|Linux|Web)$")
    message(FATAL_ERROR "Invalid portable distribution")
endif()
file(MAKE_DIRECTORY "${CounterDirectory}")
set(counter "${CounterDirectory}/${Distribution}.txt")
file(LOCK "${counter}.lock" GUARD PROCESS TIMEOUT 0)
set(number 0)
if(EXISTS "${counter}")
    file(READ "${counter}" number)
    string(STRIP "${number}" number)
    if(NOT number MATCHES "^[0-9]+$" OR number GREATER_EQUAL 9223372036854775807)
        message(FATAL_ERROR "Invalid build counter: ${counter}")
    endif()
endif()
math(EXPR number "${number} + 1")
file(WRITE "${counter}.tmp" "${number}")
file(RENAME "${counter}.tmp" "${counter}")
set(label "${number}")
while(number LESS 100 AND NOT label MATCHES "^...$")
    string(PREPEND label "0")
endwhile()
get_filename_component(header_directory "${HeaderPath}" DIRECTORY)
file(MAKE_DIRECTORY "${header_directory}")
file(WRITE "${HeaderPath}" "#pragma once\n#define SPACEYAKUZA_BUILD_LABEL \"${Distribution} v${label}\"\n")
